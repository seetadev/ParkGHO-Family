{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["contracts/**/*", "scripts/**/*", "test/**/*", "agents/**/*", "ipld/**/*", "libp2p/**/*", "pqc/**/*"],
  "exclude": ["node_modules", "dist", "dashboard"]
}
