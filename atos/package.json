{
  "name": "atos",
  "version": "1.0.0",
  "description": "Autonomous Token Orchestration System",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:filecoin": "hardhat run scripts/deploy.ts --network filecoinCalibration",
    "verify:sepolia": "hardhat run scripts/verify.ts --network sepolia",
    "node:local": "hardhat node",
    "agents:start": "docker-compose up --build",
    "agents:stop": "docker-compose down"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@types/node": "^20.0.0",
    "hardhat": "^2.19.0",
    "hardhat-gas-reporter": "^1.0.0",
    "solidity-coverage": "^0.8.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "@ipld/dag-cbor": "^9.2.0",
    "@ipld/schema": "^4.1.0",
    "multiformats": "^13.1.0",
    "libp2p": "^1.3.0",
    "@libp2p/tcp": "^9.0.0",
    "@libp2p/noise": "^15.0.0",
    "@libp2p/yamux": "^6.0.0",
    "@libp2p/kad-dht": "^12.0.0",
    "@libp2p/mdns": "^10.0.0",
    "@chainsafe/libp2p-gossipsub": "^13.0.0",
    "@libp2p/identify": "^2.0.0",
    "@libp2p/bootstrap": "^10.0.0",
    "ethers": "^6.9.0",
    "dotenv": "^16.3.0",
    "winston": "^3.11.0",
    "uuid": "^9.0.0",
    "axios": "^1.6.0"
  }
}
